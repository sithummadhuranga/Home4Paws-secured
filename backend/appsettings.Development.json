{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "JwtSettings": {
    "Issuer": "Home4Paws-Dev",
    "Audience": "Home4Paws-Users-Dev",
    "ExpiryInMinutes": 15
  },
  "ExternalServices": {
    "BaseUrl": "http://localhost:3000"
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "https://localhost:3000"
    ]
  },
  "Features": {
    "EnableSwagger": true
  },
  "ApplicationSettings": {
    "ApplicationName": "Home4Paws Platform",
    "Version": "1.0.0"
  }
}
