{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "JwtSettings": {
    "Issuer": "Home4Paws-Production",
    "Audience": "Home4Paws-Users-Production",
    "ExpiryInMinutes": 15
  },
  "ExternalServices": {
    "BaseUrl": "https://home4paws-api.railway.app"
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "https://home4paws.vercel.app",
      "https://home4paws-platform.vercel.app"
    ]
  },
  "Features": {
    "EnableSwagger": false,
    "EnableDetailedErrors": false,
    "EnableChatbot": true,
    "EnableFileUpload": true
  }
}
