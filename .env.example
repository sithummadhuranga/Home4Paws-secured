# Copy this file to .env (gitignored) and fill in real values.
# Never commit .env or put real secrets in appsettings*.json.

# Local PostgreSQL password used by docker-compose (postgres + backend)
POSTGRES_PASSWORD=change-me-local-db-password

# JWT signing key - at least 32 characters, different for every environment.
# Generate one with:  openssl rand -hex 32
JWT_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32

# First Admin account, created only when no Admin exists yet. Password needs 12+
# characters with upper/lower case, a number and a symbol. Remove it after first start.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Roboflow API key for the dog breed recognition feature (frontend build)
ROBOFLOW_API_KEY=your-roboflow-api-key

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Running the API without Docker (dotnet run) does not read this file.
# Use dotnet user-secrets from the backend folder instead:
#   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "Host=localhost;Port=5432;Database=home4paws_dev;Username=postgres;Password=<your password>"
#   dotnet user-secrets set "JwtSettings:SecretKey" "<openssl rand -hex 32>"
#   dotnet user-secrets set "SeedAdmin:Email" "<admin email>"
#   dotnet user-secrets set "SeedAdmin:Password" "<strong password>"
#
# Running the frontend without Docker (npm run dev) reads frontend/.env.local:
#   NEXT_PUBLIC_ROBOFLOW_API_KEY=<your roboflow key>
#
# Production sets the same keys as environment variables on the host:
#   ConnectionStrings__DefaultConnection, JwtSettings__SecretKey,
#   Google__ClientId, Google__ClientSecret
